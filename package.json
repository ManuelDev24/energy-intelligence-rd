{
  "name": "energy-rd",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:mobile": "npm run start --workspace apps/mobile",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace services/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace packages/core --workspace packages/api-contracts --workspace packages/api-client --workspace apps/web --workspace apps/mobile",
    "test:api": "cd services/api && uv run pytest",
    "test:all": "npm test && npm run test:api",
    "db:migrate": "cd services/api && uv run alembic upgrade head",
    "db:generate": "cd services/api && uv run alembic revision --autogenerate",
    "e2e": "npm run e2e --workspace apps/web",
    "e2e:smoke": "npm run e2e:smoke --workspace apps/web",
    "contracts:generate": "cd services/api && uv run python -m scripts.generate_contracts",
    "contracts:check": "cd services/api && uv run python -m scripts.generate_contracts --check",
    "audit:monitor": "node scripts/audit-monitor.mjs",
    "test:scripts": "node --test scripts/audit-monitor.test.mjs docs/qa/evidence/web-quality-2026-10-07/simulated-api.test.mjs scripts/bundle-budget.test.mjs"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/react-test-renderer": "19.1.0",
    "vite": "7.3.6",
    "postcss": "8.5.28",
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {},
  "dependencies": {},
  "engines": {
    "node": ">=24 <25"
  }
}
