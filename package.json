{
  "name": "energy-rd",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:mobile": "npm run start --workspace apps/mobile",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace services/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace apps/web --workspace apps/mobile --if-present",
    "test:api": "cd services/api && uv run pytest",
    "test:all": "npm test && npm run test:api",
    "db:migrate": "cd services/api && alembic upgrade head",
    "db:generate": "cd services/api && alembic revision --autogenerate"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "mcp/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {},
  "dependencies": {}
}
