{
  "expo": {
    "name": "Energy RD",
    "slug": "EnergyRD-mobile",
    "scheme": "energyrd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#197A52",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2B1F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "do.energyrd.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "do.energyrd.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B2B1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Energy RD usa la cámara solo cuando fotografías una factura de luz para leer sus datos.",
          "photosPermission": "Energy RD accede solo a las fotos que elijas (por ejemplo, una factura de luz) para leer sus datos.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
