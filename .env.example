# Copiar a .env (no se versiona). Solo valores de desarrollo local, sin secretos reales.
POSTGRES_DB=energy_rd
POSTGRES_USER=energy
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

# Driver: psycopg v3 (postgresql+psycopg). Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql+psycopg://energy:change_me_local_only@localhost:5433/energy_rd
# Base separada para pruebas (las pruebas la crean si no existe).
TEST_DATABASE_URL=postgresql+psycopg://energy:change_me_local_only@localhost:5433/energy_rd_test
ENVIRONMENT=development
# Auditoría C-03: la API arranca con la autenticación ENCENDIDA (necesita AUTH_SIGNING_KEY: 32+ bytes aleatorios, p. ej.
# `openssl rand -base64 48`). El modo piloto local sin cuentas se pide expresamente con AUTH_ENABLED=false y solo se admite con
# ENVIRONMENT=development; en staging/production la configuración rechaza AUTH_ENABLED=false y ENVIRONMENT nunca se asume.
AUTH_ENABLED=false
# AUTH_SIGNING_KEY=

# API (contenedor `api` de docker compose)
API_PORT=8000
# Orígenes CORS permitidos, separados por coma (web Next.js, Expo web). Nunca "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
# Opt-in para esta demo local; sin esta variable el contenedor no siembra datos.
# Mantener false en staging/production (la configuración rechaza true).
SEED_PILOT=true
MIGRATE_ON_START=true
# Por defecto solo loopback. Para un teléfono físico usar la IP de la interfaz LAN privada.
API_BIND_ADDRESS=127.0.0.1
# Presupuesto máximo por proceso: DB_POOL_SIZE + DB_MAX_OVERFLOW.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

# ERD-STORE-01: almacenamiento privado de originales de factura (ver services/api/STORAGE.md).
# 'disabled' por omisión: las rutas de documentos responden 503. 'local' solo para desarrollo.
STORAGE_BACKEND=disabled
# STORAGE_LOCAL_DIR=./.local-storage
# STORAGE_ENCRYPTION_KEYS=k1:<base64url de 32 bytes aleatorios>
# STORAGE_URL_SIGNING_KEY=<>=32 bytes aleatorios>
# S3/R2 (producción): bucket privado y credenciales limitadas a ese bucket.
# STORAGE_S3_BUCKET=
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
