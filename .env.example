# Copiar a .env (no se versiona). Solo valores de desarrollo local, sin secretos reales.
POSTGRES_DB=energy_rd
POSTGRES_USER=energy
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

# Driver: psycopg v3 (postgresql+psycopg). Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql+psycopg://energy:change_me_local_only@localhost:5433/energy_rd
# Base separada para pruebas (las pruebas la crean si no existe).
TEST_DATABASE_URL=postgresql+psycopg://energy:change_me_local_only@localhost:5433/energy_rd_test
ENVIRONMENT=development

# API (contenedor `api` de docker compose)
API_PORT=8000
# Orígenes CORS permitidos, separados por coma (web Next.js, Expo web). Nunca "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
# Siembra las 5 viviendas piloto (demo, idempotente) al arrancar el contenedor.
SEED_PILOT=true
