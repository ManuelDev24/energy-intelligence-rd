{
  "name": "energyrd-admin",
  "version": "0.1.0",
  "private": true,
  "description": "ERD-ADM-RBAC: minimal administrative console (roles, assignments, audit). Not the full admin suite planned for Módulo 4.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:safety": "node --test e2e/safety.test.mjs"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
